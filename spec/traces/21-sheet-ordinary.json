{
  "name": "ordinary first prompts and host commands stay silent",
  "assets": "catalogs",
  "steps": [
    { "event": { "type": "config", "enabled": true, "mode": "on", "sheet": true, "profile": "general", "streaming": false, "eagerPlan": false } },
    { "event": { "type": "draft", "now": 100, "origin": "type", "text": "Fix the broken search filters." },
      "expect": [{ "type": "view", "view": { "sheet": { "$absent": true }, "cues": [] } }] },
    { "event": { "type": "timer", "now": 800 }, "expect": [] },
    { "event": { "type": "draft", "now": 820, "origin": "paste", "text": "Write a test for parseDate." },
      "expect": [{ "type": "view", "view": { "sheet": { "$absent": true } } }] },
    { "event": { "type": "draft", "now": 850, "origin": "paste", "text": "Crée une branche pour la revue." },
      "expect": [{ "type": "view", "view": { "sheet": { "$absent": true } } }] },
    { "event": { "type": "draft", "now": 900, "origin": "paste", "text": "! build a new web app" },
      "expect": [{ "type": "view", "view": { "sheet": { "$absent": true } } }] },
    { "event": { "type": "draft", "now": 1000, "origin": "paste", "text": "Fix the broken search filters." },
      "expect": [{ "type": "view", "view": { "sheet": { "$absent": true } } }] },
    { "event": { "type": "submit", "now": 1010, "text": "Fix the broken search filters." },
      "expect": [{ "type": "submit", "text": "Fix the broken search filters.", "decisions": [] }, { "type": "view", "view": { "sheet": { "$absent": true } } }] }
  ]
}
