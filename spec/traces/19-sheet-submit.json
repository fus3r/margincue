{
  "name": "the pane advances per answer and only selected sheet options travel",
  "assets": "catalogs",
  "steps": [
    { "event": { "type": "config", "enabled": true, "mode": "auto", "sheet": true, "profile": "general", "streaming": false, "eagerPlan": false } },
    { "event": { "type": "draft", "now": 100, "origin": "paste", "text": "Build a tracker for our book club." },
      "expect": [{ "type": "request", "kind": "sheet", "req": 1 }, { "type": "view", "view": { "sheet": { "pending": true } } }] },
    { "event": { "type": "reply", "now": 300, "req": 1, "done": true, "text": "Who updates progress? | any member | organizer\nWhere should it run? | on the web | locally\nHow do people get in? | an invitation | a code" },
      "expect": [{ "type": "view", "view": { "decisions": [], "sheet": { "focus": null, "items": [{ "chosen": null }, { "chosen": null }, { "chosen": null }] } } }] },
    { "event": { "type": "sheetPane", "id": 1, "move": "open" },
      "expect": [{ "type": "view", "view": { "sheet": { "pane": { "item": "c1" } } } }] },
    { "event": { "type": "sheetAnswer", "id": 1, "now": 310, "cue": "c1", "option": 1, "via": "pane" },
      "expect": [{ "type": "view", "view": { "decisions": ["Who updates progress? organizer."],
        "sheet": { "pane": { "item": "c2" }, "items": [{ "chosen": 1 }, { "chosen": null }, { "chosen": null }] } } }] },
    { "event": { "type": "sheetAnswer", "id": 1, "now": 320, "cue": "c2", "option": 0, "via": "pane" },
      "expect": [{ "type": "view", "view": { "decisions": ["Who updates progress? organizer.", "Where should it run? on the web."] } }] },
    { "event": { "type": "sheetPane", "id": 1, "move": "skip" },
      "expect": [{ "type": "view", "view": { "sheet": { "pane": { "$absent": true } } } }] },
    { "event": { "type": "submit", "now": 340, "text": "Build a tracker for our book club." },
      "expect": [
        { "type": "submit", "text": "Build a tracker for our book club.\n\nDecisions:\n- Who updates progress? organizer.\n- Where should it run? on the web.", "decisions": ["Who updates progress? organizer.", "Where should it run? on the web."] },
        { "type": "view", "view": { "text": "", "sheet": { "collapsed": false, "afterSubmit": true, "focus": null, "items": [{ "id": "c3", "chosen": null }] } } }
      ] },
    { "event": { "type": "endAmendment", "now": 900 }, "expect": [{ "type": "view", "view": { "sheet": { "$absent": true } } }] }
  ]
}
