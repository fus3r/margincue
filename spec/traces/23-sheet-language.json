{
  "name": "English by default and draft language on request",
  "assets": "catalogs",
  "steps": [
    { "event": { "type": "config", "enabled": true, "mode": "auto", "sheet": true, "profile": "general", "streaming": false, "eagerPlan": false },
      "expect": [{ "type": "view", "view": { "state": { "language": "en" } } }] },
    { "event": { "type": "draft", "now": 100, "origin": "paste", "text": "Crée une appli pour le club. Supprime les anciens fichiers." },
      "expect": [{ "type": "request", "kind": "sheet", "req": 1, "prompt": "Crée une appli pour le club. Supprime les anciens fichiers." },
        { "type": "view", "view": { "state": { "first": { "slot": "cleanup_reach", "label": "Cleanup" } } } }] },
    { "event": { "type": "set", "now": 105, "slot": "cleanup_reach", "option": "unused_only", "scope": "session" },
      "expect": [{ "type": "persist", "action": "set" }, { "type": "view", "view": { "decisions": ["Deletion targets unreferenced matches only."],
        "state": { "marks": [{ "label": "Cleanup", "value": "unreferenced matches only" }] } } }] },
    { "event": { "type": "reply", "now": 200, "req": 1, "done": true, "text": "Where should it run? | browser | mobile\nWho has access? | club members | the public" },
      "expect": [{ "type": "view", "view": { "sheet": { "language": "en", "items": [{ "statement": "Where should it run?" }, { "statement": "Who has access?" }] } } }] },
    { "event": { "type": "pick", "now": 240, "cue": "c1", "option": 0 },
      "expect": [{ "type": "view", "view": { "decisions": ["Where should it run? browser.", "Deletion targets unreferenced matches only."] } }] },
    { "event": { "type": "submit", "now": 260, "text": "Crée une appli pour le club. Supprime les anciens fichiers." },
      "expect": [{ "type": "submit", "text": "Crée une appli pour le club. Supprime les anciens fichiers.\n\nDecisions:\n- Where should it run? browser.\n- Deletion targets unreferenced matches only." },
        { "type": "view", "view": { "sheet": { "afterSubmit": true, "collapsed": false, "language": "en" } } }] },
    { "event": { "type": "sheetAnswer", "now": 280, "id": 1, "cue": "c2", "option": 0, "via": "composer" },
      "expect": [{ "type": "amend", "text": "Amendment to my last prompt: Who has access? club members." },
        { "type": "view", "view": { "sheet": { "$absent": true } } }] },
    { "event": { "type": "endAmendment", "now": 300 }, "expect": [] },
    { "event": { "type": "config", "enabled": true, "mode": "auto", "language": "auto", "sheet": true, "profile": "general", "streaming": false, "eagerPlan": false }, "expect": [] },
    { "event": { "type": "draft", "now": 500, "origin": "paste", "text": "Crée un site pour le club. Supprime les anciens fichiers." },
      "expect": [{ "type": "request", "kind": "sheet", "req": 2 }, { "type": "view", "view": { "decisions": ["La suppression vise les éléments non référencés."],
        "state": { "language": "fr", "marks": [{ "label": "Nettoyage", "value": "les éléments non référencés" }] } } }] },
    { "event": { "type": "reply", "now": 700, "req": 2, "done": true, "text": "Où héberger le site ? | en local | sur le web" },
      "expect": [{ "type": "view", "view": { "sheet": { "language": "fr", "items": [{ "statement": "Où héberger le site ?" }] } } }] }
  ]
}
